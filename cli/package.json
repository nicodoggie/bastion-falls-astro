{
  "name": "@bastion-falls/cli",
  "author": "",
  "description": "Stricli command line application",
  "license": "MIT",
  "type": "module",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "bin": {
    "__cli_bash_complete": "dist/bash-complete.js",
    "bfcli": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "tsc -p src/tsconfig.json",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p src/tsconfig.json --noEmit",
    "exec": "tsx --tsconfig src/tsconfig.json src/bin/cli.ts"
  },
  "dependencies": {
    "@bastion-falls/calendar": "workspace:^",
    "@bastion-falls/types": "workspace:^",
    "@stricli/auto-complete": "^1.2.9",
    "@stricli/core": "^1.2.9",
    "adm-zip": "^0.5.18",
    "ejs": "^6.0.1",
    "env-paths": "^4.0.0",
    "esm-path": "^1.0.1",
    "find-up": "^8.0.0",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.5",
    "nodejs-whisper": "^0.3.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-stringify": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "undici": "^6.27.0",
    "vfile": "^6.0.3",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "volta": {
    "extends": "../package.json"
  }
}
