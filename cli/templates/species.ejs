  type: <%= species.type %>
  <%_ } _%>
  <%_ if (species.origin) { _%>
  origin: <%= species.origin %>
  <%_ } _%>
  <%_ if (species.lifespan) { _%>
  lifespan: <%= species.lifespan %>
  <%_ } _%>
