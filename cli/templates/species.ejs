  <%_ } _%>
  <%_ if (species.biomes && species.biomes.length > 0) { _%>
  biomes:
    <%_ species.biomes.forEach(function(biome){ _%>
    - <%- biome %>
    <%_ }) _%>
  <%_ } _%>
  <%_ if (species.traits && species.traits.length > 0) { _%>
  traits:
    <%_ species.traits.forEach(function(trait){ _%>
    - <%- trait %>
    <%_ }) _%>
  <%_ } _%>
  <%_ if (species.diet && species.diet.length > 0) { _%>
  diet:
    <%_ species.diet.forEach(function(item){ _%>
    - <%- item %>
    <%_ }) _%>
  <%_ } _%>
