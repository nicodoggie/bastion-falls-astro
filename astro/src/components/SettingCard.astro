---
import { type CollectionEntry, getCollection } from "astro:content";
import { slug } from "github-slugger";

type CharacterEntry = CollectionEntry<"character">;
type CharacterReference =
  | string
  | {
      name: string;
      id?: string;
      slug?: string;
    };

interface Props {
  location?: string;
  date?: string;
  characters?: CharacterReference | CharacterReference[];
}

interface ResolvedCharacter {
  name: string;
  href?: string;
}

interface CharacterEntryData {
  title?: string;
  character?: {
    name?: string;
    aliases?: string[];
    details?: {
      aliases?: string[];
    };
  };
}

const { location, date, characters } = Astro.props;
const details = [
  { label: "Location", value: location },
  { label: "Date", value: date },
].filter((item) => item.value);

const characterReferences = normalizeCharacters(characters);
const characterEntries =
  characterReferences.length > 0 ? await getCollection("character") : [];
const characterIndex = buildCharacterIndex(characterEntries);
const resolvedCharacters = characterReferences.map((character) =>
  resolveCharacter(character, characterIndex),
);

function normalizeCharacters(
  characters: CharacterReference | CharacterReference[] | undefined,
) {
  if (!characters) return [];
  return Array.isArray(characters) ? characters : [characters];
}

function buildCharacterIndex(entries: CharacterEntry[]) {
  const index = new Map<string, CharacterEntry>();

  for (const entry of entries) {
    const data = getCharacterData(entry);
    addIndexKey(index, entry.id, entry);
    addIndexKey(index, data.title, entry);

    const character = data.character;
    addIndexKey(index, character?.name, entry);

    for (const alias of character?.aliases ?? []) {
      addIndexKey(index, alias, entry);
    }

    for (const alias of character?.details?.aliases ?? []) {
      addIndexKey(index, alias, entry);
    }
  }

  return index;
}

function addIndexKey(
  index: Map<string, CharacterEntry>,
  value: string | undefined,
  entry: CharacterEntry,
) {
  if (!value) return;
  index.set(value.toLowerCase(), entry);
  index.set(slug(value), entry);
}

function resolveCharacter(
  character: CharacterReference,
  index: Map<string, CharacterEntry>,
): ResolvedCharacter {
  const name = typeof character === "string" ? character : character.name;
  const explicitId =
    typeof character === "string"
      ? undefined
      : (character.id ?? character.slug);
  const entry =
    (explicitId && index.get(explicitId)) ||
    (explicitId && index.get(slug(explicitId))) ||
    index.get(name.toLowerCase()) ||
    index.get(slug(name));
  const data = entry ? getCharacterData(entry) : undefined;

  return {
    name: data?.character?.name ?? data?.title ?? name,
    href: entry ? `/world/characters/${entry.id}/` : undefined,
  };
}

function getCharacterData(entry: CharacterEntry): CharacterEntryData {
  return entry.data as CharacterEntryData;
}
---

<aside class="setting-card" aria-label="Scene setting">
  <div class="setting-card__header">
    <p class="setting-card__eyebrow">Setting</p>
  </div>

  <dl class="setting-card__details">
    {details.map(({ label, value }) => (
        <div class="setting-card__detail">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    {resolvedCharacters.length > 0 && (
      <div class="setting-card__detail setting-card__detail--wide">
        <dt>Characters</dt>
        <dd>
          <ul class="setting-card__characters" aria-label="Scene characters">
            {resolvedCharacters.map(({ name, href }) => (
              <li>
                {href ? (
                  <a href={href} class="setting-card__character">
                    {name}
                  </a>
                ) : (
                  <span class="setting-card__character setting-card__character--plain">
                    {name}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )}
  </dl>
</aside>

<style>
.setting-card {
  background: linear-gradient(135deg, #10204f, #31205f);
  border: 1px solid rgba(167, 139, 250, 0.32);
  border-left: 0.35rem solid #6d5bd0;
  border-radius: 0.5rem;
  box-shadow: 0 0.65rem 1.25rem rgba(0, 0, 0, 0.12);
  margin: 1.5rem 0 1.25rem;
  overflow: hidden;
  padding: 1rem 1.1rem;
}

.setting-card__header {
  align-items: center;
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.setting-card__header::before {
  background: #a78bfa;
  border-radius: 999px;
  content: "";
  display: block;
  height: 0.55rem;
  width: 0.55rem;
}

.setting-card__eyebrow {
  color: #c4b5fd;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1;
  margin: 0;
  text-transform: uppercase;
}

.setting-card__details {
  display: grid;
  gap: 0.8rem 1.25rem;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  margin: 0;
}

.setting-card__detail {
  min-width: 0;
}

.setting-card__detail--wide {
  grid-column: 1 / -1;
}

.setting-card dt {
  color: rgba(219, 234, 254, 0.72);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  margin: 0 0 0.2rem;
  text-transform: uppercase;
}

.setting-card dd {
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.35;
  margin: 0;
  overflow-wrap: anywhere;
}

.setting-card__characters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.setting-card__character {
  background: rgba(196, 181, 253, 0.14);
  border: 1px solid rgba(196, 181, 253, 0.28);
  border-radius: 999px;
  color: #ffffff;
  display: inline-flex;
  font-size: 0.9rem;
  font-weight: 700;
  line-height: 1.2;
  padding: 0.28rem 0.62rem;
  text-decoration: none;
}

a.setting-card__character:hover,
a.setting-card__character:focus-visible {
  background: rgba(196, 181, 253, 0.24);
  border-color: rgba(221, 214, 254, 0.55);
  text-decoration: underline;
}

.setting-card__character--plain {
  color: rgba(255, 255, 255, 0.88);
}

@media (max-width: 35rem) {
  .setting-card {
    padding: 0.9rem 1rem;
  }
}
</style>
