---
import type { Vehicle } from '@bastion-falls/types';
import { getEntry } from 'astro:content';
import { slug } from 'github-slugger';

interface Props {
  vehicle: Omit<Vehicle, 'name'> & { name?: string };
  name?: string;
  link?: string;
}

const { vehicle, name, link } = Astro.props;
const displayName = name || vehicle.name || 'Unknown Vehicle';

// Calculate ability modifiers
function getModifier(score: number): string {
  const mod = Math.floor((score - 10) / 2);
  return mod >= 0 ? `+${mod}` : `${mod}`;
}

// Format speed
function formatSpeed(speed: any): string | null {
  if (!speed) return null;
  const parts = [];
  if (speed.base) parts.push(`${speed.base} ft.`);
  if (speed.fly) parts.push(`fly ${speed.fly} ft.`);
  if (speed.swim) parts.push(`swim ${speed.swim} ft.`);
  if (speed.burrow) parts.push(`burrow ${speed.burrow} ft.`);
  if (speed.water) parts.push(`water ${speed.water} ft.`);
  if (speed.land) parts.push(`land ${speed.land} ft.`);
  if (speed.air) parts.push(`air ${speed.air} ft.`);
  if (speed.special) parts.push(speed.special);

  return parts.join(', ');
}

// Format range
function formatRange(range: number | { min: number; max: number }): string {
  if (typeof range === 'number') return `${range} ft.`;
  return `${range.min}/${range.max} ft.`;
}

// Capitalize first letter
function capitalize(str: string): string {
  return str.charAt(0).toUpperCase() + str.slice(1);
}

// Get character entries for crew members
const crewWithEntries = vehicle.crew ? await Promise.all(
  vehicle.crew.map(async (member) => {
    const slugged = slug(member.name);
    const entry = await getEntry('character', slugged);
    return {
      ...member,
      entry,
      link: entry ? `/world/characters/${entry.id}` : undefined,
    };
  })
) : [];
---

<div
  class="vehicle-stat-block not-content bg-[#faf7ea] dark:bg-[#1a1a1a]
    text-[#58180d] dark:text-[#e8dcc4] rounded-lg shadow-lg p-6 my-6
    border-2 border-[#58180d] dark:border-[#9b8c7e] font-serif max-w-3xl"
>
  <!-- Header -->
  <div class="border-b-2 border-[#58180d] dark:border-[#9b8c7e] pb-2 mb-4">
    {link ? (
      <a href={link} class="no-underline hover:opacity-80 transition-opacity">
        <h2
          class="text-3xl font-bold text-center mb-1 text-[#58180d]
          dark:text-[#e8dcc4]"
        >
          {displayName}
        </h2>
      </a>
    ) : (
      <h2
        class="text-3xl font-bold text-center mb-1 text-[#58180d]
        dark:text-[#e8dcc4]"
      >
        {displayName}
      </h2>
    )}
    <p class="text-center italic text-sm text-[#7a271a] dark:text-[#c9b99a]">
      {capitalize(vehicle.stats.size)} vehicle ({vehicle.type})
    </p>
  </div>

  <!-- Base Stats -->
  <div class="grid grid-cols-6 gap-2 mb-4 text-center">
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        STR
      </div>
      <div class="text-sm">
        {vehicle.stats.strength} ({getModifier(vehicle.stats.strength)})
      </div>
    </div>
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        DEX
      </div>
      <div class="text-sm">
        {vehicle.stats.dexterity} ({getModifier(vehicle.stats.dexterity)})
      </div>
    </div>
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        CON
      </div>
      <div class="text-sm">
        {vehicle.stats.constitution} ({getModifier(vehicle.stats.constitution)})
      </div>
    </div>
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        INT
      </div>
      <div class="text-sm">
        {vehicle.stats.intelligence} ({getModifier(vehicle.stats.intelligence)})
      </div>
    </div>
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        WIS
      </div>
      <div class="text-sm">
        {vehicle.stats.wisdom} ({getModifier(vehicle.stats.wisdom)})
      </div>
    </div>
    <div>
      <div
        class="text-xs font-bold uppercase text-[#58180d] dark:text-[#c9b99a]"
      >
        CHA
      </div>
      <div class="text-sm">
        {vehicle.stats.charisma} ({getModifier(vehicle.stats.charisma)})
      </div>
    </div>
  </div>

  <hr class="border-t border-[#58180d] dark:border-[#9b8c7e] my-3" />

  <!-- Travel Pace -->
  <div class="mb-2">
    <span class="font-bold text-[#58180d] dark:text-[#e8dcc4]">Travel Pace</span
    >
    <span class="text-[#58180d] dark:text-[#c9b99a]">
      {vehicle.travelPace} miles per hour
    </span>
  </div>

  <!-- Capacity -->
  <div class="mb-2">
    <span class="font-bold text-[#58180d] dark:text-[#e8dcc4]">Capacity</span>
    <span class="text-[#58180d] dark:text-[#c9b99a]">
      {vehicle.capacity.crew} crew{
        vehicle.capacity.passengers
          ? `, ${vehicle.capacity.passengers} passengers`
          : ''
      }{vehicle.capacity.cargo ? `, ${vehicle.capacity.cargo} tons cargo` : ''}
    </span>
  </div>

  <!-- Crew -->
  {
    crewWithEntries && crewWithEntries.length > 0 && (
      <div class="mb-4">
        <div class="font-bold text-[#58180d] dark:text-[#e8dcc4] mb-1">
          Crew
        </div>
        <ul class="list-none pl-4 space-y-1">
          {crewWithEntries.map((member) => (
            <li class="text-[#58180d] dark:text-[#c9b99a]">
              {member.link ? (
                <a href={member.link} class="font-semibold hover:underline">
                  {member.name}
                </a>
              ) : (
                <span class="font-semibold">{member.name}</span>
              )}
              {' - '}
              <span class="italic">{member.position}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Sections -->
  {
    vehicle.sections && vehicle.sections.length > 0 && (
      <>
        <hr class="border-t-2 border-[#58180d] dark:border-[#9b8c7e] my-4" />

        {vehicle.sections.map((section) => (
          <div class="mb-4 border-l-4 border-[#7a271a] dark:border-[#9b8c7e] pl-3">
            <h4 class="font-bold text-lg text-[#58180d] dark:text-[#e8dcc4]">
              {section.name}
              {section.count && section.count > 1 ? ` (${section.count})` : ''}
            </h4>

            <div class="text-sm space-y-1">
              <div>
                <span class="font-semibold">Armor Class:</span>{' '}
                {section.armorClass}
              </div>

              <div>
                <span class="font-semibold">Hit Points:</span>{' '}
                {section.hitPoints.base}
                {section.hitPoints.damageThreshold &&
                  ` (damage threshold ${section.hitPoints.damageThreshold})`}
              </div>

              {section.hitPoints.special && (
                <div class="italic text-xs pl-4 whitespace-pre-line">
                  {section.hitPoints.special.trim()}
                </div>
              )}

              {section.speed && (
                <div>
                  <span class="font-semibold">Speed:</span>{' '}
                  {formatSpeed(section.speed)}
                </div>
              )}

              {section.description && (
                <div class="italic text-sm pl-2 whitespace-pre-line">
                  {section.description.trim()}
                </div>
              )}

              {section.actions && section.actions.length > 0 && (
                <div class="mt-2">
                  <div
                    class="font-semibold text-[#58180d]
                    dark:text-[#e8dcc4] mb-1"
                  >
                    Actions
                  </div>
                  {section.actions.map((action) => (
                    <div class="pl-2 mb-2">
                      <div>
                        <span class="italic font-semibold">
                          {capitalize(action.type)}:
                        </span>{' '}
                        {action.damage.toHit >= 0 ? '+' : ''}
                        {action.damage.toHit} to hit, range{' '}
                        {formatRange(action.range)}, one target.
                      </div>
                      <div class="pl-2">
                        <span class="italic">Hit:</span> {action.damage.amount}{' '}
                        {action.damage.type} damage.
                      </div>
                      {action.description && (
                        <div class="text-xs italic pl-2 mt-1">
                          {action.description}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </>
    )
  }
</div>

<style>
  .vehicle-stat-block {
    font-family: 'Libre Baskerville', 'Book Antiqua', 'Georgia', serif;
  }

  .vehicle-stat-block h2,
  .vehicle-stat-block h3,
  .vehicle-stat-block h4 {
    font-family: 'Modesto Condensed', 'Palatino Linotype', 'Palatino', serif;
  }

  /* Use system fonts if custom fonts aren't available */
  @supports not (font-family: 'Modesto Condensed') {
    .vehicle-stat-block h2,
    .vehicle-stat-block h3,
    .vehicle-stat-block h4 {
      font-family: 'Palatino Linotype', 'Palatino', 'Georgia', serif;
      letter-spacing: 0.03em;
    }
  }
</style>
