---
import SidebarCard from "./SidebarCard.astro";
import SidebarDetail from "./SidebarDetail.astro";
import SidebarMedia from "./SidebarMedia.astro";

const { item, filePath } = Astro.props;
---

<SidebarCard title={item.name} href={item?.ddb}>
  {item.image && (
    <SidebarMedia slot="image" image={item.image} entryFilePath={filePath} />
  )}
  <dl class="divide-y divide-gray-200 dark:divide-gray-700">
    {item.details?.attunement !== undefined && (
          <SidebarDetail label="Attunement">
            {item.details.attunement ? 'Yes' : 'No'}
          </SidebarDetail>
        )}
    {item.details?.type !== undefined && (
          <SidebarDetail label="Type">{item.details.type}</SidebarDetail>
        )}
    {item.details?.rarity !== undefined && (
          <SidebarDetail label="Rarity">{item.details.rarity}</SidebarDetail>
        )}
    {item.details?.weight !== undefined && (
          <SidebarDetail label="Weight">{item.details.weight}</SidebarDetail>
        )}
    {item.details?.value !== undefined && (
          <SidebarDetail label="Value">{item.details.value}</SidebarDetail>
        )}
  </dl>
</SidebarCard>
