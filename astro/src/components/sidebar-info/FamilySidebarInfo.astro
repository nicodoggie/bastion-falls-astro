---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type {
  Character,
  CharacterFamily,
} from "@bastion-falls/types/Character";
import type { Family } from "@bastion-falls/types/Family";
import { slug } from "github-slugger";
import SidebarCard from "./SidebarCard.astro";
import SidebarDetail from "./SidebarDetail.astro";
import SidebarMedia from "./SidebarMedia.astro";

interface Props {
  /** Family frontmatter; `name` may be omitted when the page title is canonical. */
  family: Partial<Family>;
  filePath?: string;
  title: string;
}

interface CharacterDocData {
  title: string;
  character?: Character;
}

const { family, filePath, title } = Astro.props;

const displayName = family.name ?? title;
const familySlug = slug(family.name ?? title);

let members: CollectionEntry<"character">[] = [];
if (familySlug) {
  const allCharacters = await getCollection("character");
  members = allCharacters.filter((c) => {
    const data = c.data as CharacterDocData;
    return data.character?.relationships?.families?.some(
      (f: CharacterFamily) => slug(f.name) === familySlug,
    );
  });
  members.sort((a, b) => {
    const da = a.data as CharacterDocData;
    const db = b.data as CharacterDocData;
    return (da.title ?? "").localeCompare(db.title ?? "", undefined, {
      sensitivity: "base",
    });
  });
}
---

<SidebarCard title={displayName}>
  {family.image && (
    <SidebarMedia slot="image" image={family.image} entryFilePath={filePath} />
  )}
  <dl class="divide-y divide-gray-200 dark:divide-gray-700">
    {family.founded && (
          <SidebarDetail label="Founded">{family.founded}</SidebarDetail>
        )}
    {family.dissolved && (
          <SidebarDetail label="Dissolved">{family.dissolved}</SidebarDetail>
        )}
    {family.seat && (
          <SidebarDetail label="Seat">{family.seat}</SidebarDetail>
        )}
    {family.motto && (
          <SidebarDetail label="Motto">{family.motto}</SidebarDetail>
        )}
    {members.length > 0 && (
          <SidebarDetail label="Members" layout="stacked">
              <ul class="space-y-1 text-right">
                {members.map((member) => {
                  const md = member.data as CharacterDocData;
                  return (
                    <li>
                      <a href={`/world/characters/${member.id}`}>
                        {md.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
          </SidebarDetail>
        )}
  </dl>
</SidebarCard>
