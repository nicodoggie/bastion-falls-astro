---
import { type CollectionEntry, getEntry } from "astro:content";
import type {
  CharacterFamily,
  CharacterOrganization,
} from "@bastion-falls/types/Character";
import { slug } from "github-slugger";
import CharacterPcStats from "./CharacterPcStats.astro";
import CharacterSexOrgans from "./CharacterSexOrgans.astro";
import SidebarCard from "./SidebarCard.astro";
import SidebarDetail from "./SidebarDetail.astro";
import SidebarMedia from "./SidebarMedia.astro";

const { character, filePath } = Astro.props;

let mortalityIcon: string;
switch (character.details.mortality) {
  case "dead":
    mortalityIcon = "💀";
    break;
  case "alive":
    mortalityIcon = "";
    break;
  case "undead":
    mortalityIcon = "🧟";
    break;
  case "unknown":
    mortalityIcon = "�";
    break;
  default:
    mortalityIcon = "";
}

interface SpeciesData {
  name: string;
  entry?: CollectionEntry<"species">;
}

let species: SpeciesData[] = [];
if (character?.details?.species) {
  const speciesNames = Array.isArray(character.details.species)
    ? character.details.species
    : [character.details.species];

  species = (
    await Promise.allSettled<SpeciesData>(
      speciesNames.map(async (name: string) => {
        const sluggedName = slug(name);
        if (sluggedName) {
          const entry = await getEntry("species", sluggedName);
          return { name, entry };
        }
        throw new Error(`Species ${name} has no slugged name`);
      }),
    )
  )
    .map((settled) => (settled.status === "fulfilled" ? settled.value : null))
    .filter((s): s is SpeciesData => s !== null && s.entry !== undefined);
}

interface Relative {
  name: string;
  type: string;
  entry: CollectionEntry<"character">;
}

let relatives: Relative[] = [];
if (character?.relationships?.relatives) {
  relatives = (
    await Promise.allSettled<Relative>(
      character.relationships.relatives.map(
        async ({ name, type }: { name: string; type: string }) => {
          const sluggedName = slug(name);
          if (sluggedName) {
            const entry = await getEntry("character", sluggedName);
            return { name, type, entry };
          }
          throw new Error(`Relative ${name} has no slugged name`);
        },
      ),
    )
  )
    .map((settled) => (settled.status === "fulfilled" ? settled.value : null))
    .filter((relative) => relative !== null);
}

// Sort by relative type
relatives.sort((a, b) => a.type.localeCompare(b.type));

interface OrganizationData {
  name: string;
  positionsHeld: CharacterOrganization["positionsHeld"];
  entry?: CollectionEntry<"organization">;
}
let organizations: OrganizationData[] = [];
if (character?.relationships?.organizations) {
  organizations = (
    await Promise.allSettled<OrganizationData>(
      character.relationships.organizations.map(
        async (organization: CharacterOrganization) => {
          const sluggedName = slug(organization.name);
          const entry = sluggedName
            ? await getEntry("organization", sluggedName)
            : undefined;

          return {
            name: organization.name,
            positionsHeld: organization.positionsHeld,
            entry,
          };
        },
      ),
    )
  )
    .map((settled) => (settled.status === "fulfilled" ? settled.value : null))
    .filter((organization) => organization !== null);
}

interface FamilyData {
  name: string;
  entry: CollectionEntry<"family">;
}

let families: FamilyData[] = [];
if (character?.relationships?.families) {
  families = (
    await Promise.allSettled<FamilyData>(
      character.relationships.families.map(async (family: CharacterFamily) => {
        const sluggedName = slug(family.name);
        if (sluggedName) {
          const entry = await getEntry("family", sluggedName);
          return { name: family.name, entry };
        }
        throw new Error(`Family ${family.name} has no slugged name`);
      }),
    )
  )
    .map((settled) => (settled.status === "fulfilled" ? settled.value : null))
    .filter((family) => family !== null);
}
---

<SidebarCard title={character.name} href={character.ddb}>
  <span slot="title-suffix" class="mortality-icon p-1">{mortalityIcon}</span>
  {character.image && (
    <SidebarMedia slot="image" image={character.image} entryFilePath={filePath} />
  )}
  <CharacterPcStats character={character} />
  <dl class="divide-y divide-gray-200 dark:divide-gray-700">
    {character.details?.age && (
          <SidebarDetail label="Age">{character.details.age}</SidebarDetail>
        )}
    {character.details?.dateOfBirth && (
          <SidebarDetail label="Date of Birth">
            {character.details.dateOfBirth}
          </SidebarDetail>
        )}
    {character.details?.dateOfDeath && (
          <SidebarDetail label="Date of Death">
            {character.details.dateOfDeath}
          </SidebarDetail>
        )}
    {character?.details.sex && (
          <SidebarDetail label="Sex">
            {character.details.sex}{character.details.pronouns && ` (${character.details.pronouns})`}
          </SidebarDetail>
        )}
    {character?.details.sexOrgans && character.details.sexOrgans.length > 0 && (
          <SidebarDetail label="Genitalia" layout="stacked">
              <CharacterSexOrgans sexOrgans={character.details.sexOrgans} />
          </SidebarDetail>
        )}
    {character.details?.origin && (
          <SidebarDetail label="Origin">
            {character.details.origin}
          </SidebarDetail>
        )}
    {character.background?.alignment && (
          <SidebarDetail label="Alignment">
            {character.background.alignment.moral}{' '}
            {character.background.alignment.law}
          </SidebarDetail>
        )}
    {character.details?.aliases && (
          <SidebarDetail label="Known Aliases">
            { 
              character.details.aliases.length > 0 && character.details.aliases.map((alias: string) => {
                return (
                  <div>
                    <span data-pagefind-meta="alias">{alias}</span>
                  </div>
                )
              })
            }
          </SidebarDetail>
        )}
    {organizations && (
          <SidebarDetail label="Organizations" layout="stacked">
              <div class="space-y-3 text-right">
                {organizations.map(
                  ({ positionsHeld, entry, name }) => (
                    <div class="space-y-1">
                    <a class="text-gray-600 dark:text-gray-400" href={entry?.id != null ? `/organizations/${entry.id}` : "#"}>{name}</a>
                    <ul class="space-y-1 text-xs text-gray-500 dark:text-gray-400">
                      {positionsHeld?.map((position) => (
                        <li>{position.name} {position.from && `(${position.from}`} {position.to && ` - ${position.to})`}</li>
                      ))}
                    </ul>
                    </div>
                  )
                )}
              </div>
          </SidebarDetail>
        )}
    {relatives && (
          <SidebarDetail label="Relatives" layout="stacked">
              <dl class="space-y-2">
                {relatives.map((relative: Relative) => {
                  return (
                  <div class="flex flex-wrap items-start justify-end gap-x-3 gap-y-1">
                    <dt class="shrink-0 text-sm text-gray-500 dark:text-gray-400">
                      {relative.type}
                    </dt>
                    <dd class="min-w-0 text-right">
                    <a href={relative.entry ? `/world/characters/${relative.entry.id}` : undefined}>
                      {(relative.entry?.data as { title?: string } | undefined)
                        ?.title || relative.name}
                    </a>
                    </dd>
                  </div>
                  );
                })}
              </dl>
          </SidebarDetail>
        )}
    {character.relationships?.other &&
        character.relationships.other.length > 0 && (
          <SidebarDetail label="Other relationships">
              <ul>
                {character.relationships.other.map(
                  (rel: { name: string; type: string }) => (
                  <li>
                    {rel.name}
                    {rel.type && ` (${rel.type})`}
                  </li>
                ))}
              </ul>
          </SidebarDetail>
        )}
    {families && (
          <SidebarDetail label="Families" layout="stacked">
              <ul class="space-y-1 text-right">
                {families.map((family: {name: string, entry: CollectionEntry<"family">}) => (
                  <li>
                    <a href={family.entry && `/world/families/${family.entry?.id}`}>{family.name}</a>
                  </li>
                ))}
              </ul>
          </SidebarDetail>
        )}
    {character.details?.species && species && (
          <SidebarDetail label="Species">
              <ul>
                {species.map((s: SpeciesData) => s.entry && (
                  <li>
                    <a href={`/world/species/${s.entry.id}`}>
                      {(s.entry.data as { title: string }).title}
                    </a>
                  </li>
                ))}
              </ul>
          </SidebarDetail>
        )}
    {character.details?.height && (
          <SidebarDetail label="Height">
            {character.details.height}
          </SidebarDetail>
        )}
    {character.details?.weight && (
          <SidebarDetail label="Weight">
            {character.details.weight}
          </SidebarDetail>
        )}
    {character.background?.goals && (
          <SidebarDetail label="Goals">
            {character.background.goals}
          </SidebarDetail>
        )}
    {character.background?.flaws && (
          <SidebarDetail label="Flaws">
            {character.background.flaws}
          </SidebarDetail>
        )}
    {character.background?.backstory && (
          <SidebarDetail label="Backstory">
            {character.background.backstory}
          </SidebarDetail>
        )}
  </dl>
</SidebarCard>
