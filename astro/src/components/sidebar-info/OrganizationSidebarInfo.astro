---
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import type { OrganizationMember } from "@bastion-falls/types/Organization";
import { slug } from "github-slugger";
import SidebarCard from "./SidebarCard.astro";
import SidebarDetail from "./SidebarDetail.astro";
import SidebarMedia from "./SidebarMedia.astro";

const { organization, filePath } = Astro.props;

// Get member character entries if they exist
interface MemberData {
  name: string;
  type: string;
  entry: CollectionEntry<"character">;
}

let members: MemberData[] = [];
if (organization?.members) {
  members = (
    await Promise.allSettled<MemberData>(
      organization.members.map(async (memberName: OrganizationMember) => {
        const { name, type } = memberName;
        const sluggedName = slug(name);
        if (sluggedName) {
          const entry = await getEntry("character", sluggedName);
          return { name, type, entry };
        }
        throw new Error(`Member ${memberName.name} has no slugged name`);
      }),
    )
  )
    .map((settled) => (settled.status === "fulfilled" ? settled.value : null))
    .filter((member) => member !== null);
}
---

<SidebarCard title={organization.name}>
  {organization.image && (
    <SidebarMedia
      slot="image"
      image={organization.image}
      entryFilePath={filePath}
    />
  )}
  <dl class="divide-y divide-gray-200 dark:divide-gray-700">
    {organization?.type && (
          <SidebarDetail label="Type">
              {organization.type.charAt(0).toUpperCase() + organization.type.slice(1)}
          </SidebarDetail>
        )}

    {organization?.founded && (
          <SidebarDetail label="Founded">{organization.founded}</SidebarDetail>
        )}

    {organization?.dissolved && (
          <SidebarDetail label="Dissolved">{organization.dissolved}</SidebarDetail>
        )}

    {organization?.headquarters && (
          <SidebarDetail label="Headquarters">
            {organization.headquarters}
          </SidebarDetail>
        )}

    {members && members.length > 0 && (
          <SidebarDetail label="Members" layout="stacked">
            <ul class="space-y-1 text-right text-gray-600 dark:text-gray-400">
              {members.map((member: MemberData) => (
                <li>
                  <a href={`/world/characters/${member.entry?.id}`}>
                    {(member.entry?.data as { title?: string } | undefined)?.title ||
                      member.name}
                    {member.type && ` (${member.type})`}
                  </a>
                </li>
              ))}
            </ul>
          </SidebarDetail>
        )}
  </dl>
</SidebarCard>
