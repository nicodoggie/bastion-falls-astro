      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "ka-brast",
        "etymon:gloss": "like-dominant.arm",
        "etymon:note": "Shows metaphorical extension to manual craft skills",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "skilled with hands, manually dexterous"
          },
          "lexinfo:semanticField": "Body Parts",
          "usage": "Specifically for craft skills requiring hand coordination; does not extend to martial or athletic dexterity"
        }
