{
  "@context": {
    "@vocab": "http://www.w3.org/ns/lemon/ontolex#",
    "ontolex": "http://www.w3.org/ns/lemon/ontolex#",
    "lexinfo": "http://www.lexinfo.net/ontology/3.0/lexinfo#",
    "decomp": "http://www.w3.org/ns/lemon/decomp#",
    "etymon": "http://www.lexinfo.net/lemon/etymon#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "lime": "http://www.w3.org/ns/lemon/lime#",
    "lexvo": "http://lexvo.org/id/",
    "dc": "http://purl.org/dc/elements/1.1/",
    "bf": "https://bastion-falls.thekennel.info/languages/",
    "ehk": "#"
  },
  "@id": "lexicon:EarlyHick_Suffixes",
  "@type": "lime:Lexicon",
  "dc:title": "Early Hick Lexicon - Suffix entries",
  "dc:language": {
    "@id": "bf:hickic/seneran/early-hick",
    "skos:prefLabel": "Early Hick"
  },
  "@graph": [
    {
      "@id": "ehk:ano-",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Prefix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "a.no",
        "writtenRep": "ano-"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "ango",
          "etymon:sourceGloss": "dragon",
          "etymon:sourceLanguage": "Quenya"
        },
        "etymon:note": "High-register honorific and intensifying prefix, reinforced by reanalysis of anuloke as ano-loke once loke became a recognizable learned draconic element.",
        "etymon:soundChange": "Quenya repair and grammaticalization"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "great, grand, majestic, exalted, awe-inspiring"
          },
          "lexinfo:semanticField": [
            "Grammatical Terms",
            "Honorifics",
            "High Register",
            "Borrowed Terms"
          ],
          "usage": "Formal or ceremonial intensifier distinct from ordinary native tor-."
        }
      ]
    },
    {
      "@id": "ehk:-asam",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-a.səm",
        "writtenRep": "-asam"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:cognateWith": "asam",
        "etymon:note": "Cognate with lexical asam 'rest, resting place' from Proto-Hick *xasamu. The case marker and noun share an older locative/resting-place source rather than deriving through a live asam'er verbal chain.",
        "etymon:protoform": "Proto-Hick *xasamu",
        "etymon:soundChange": "grammaticalization as spatial case marker"
      },
      "related": [
        {
          "@id": "ehk:asam",
          "note": "cognate lexical noun",
          "relationshipType": "cognate with"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "downward, down onto, toward a resting place (sublative suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Spatial Cases"]
        }
      ]
    },
    {
      "@id": "ehk:suffixes-en",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-en",
        "writtenRep": "-en"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Inherited medial direct inanimate/default demonstrative. An older animate counterpart was lost or merged with this form, leaving Early Hick to renew the animate medial direct demonstrative with contact-derived -tan.",
        "etymon:protoform": "Proto-Hick *ena",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (inanimate, visible, medial)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-esp",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-esp",
        "writtenRep": "-esp"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:derivedFrom": "wesp",
        "etymon:note": "Grammaticalized from wesp 'cellar, basement, lower enclosed space', itself from older *wesu pu 'within an enclosure, enclosed interior'. The initial w- was lost as the form became a bound case suffix.",
        "etymon:protoform": "Proto-Hick *wesu pu",
        "etymon:soundChange": "compound reduction and loss of initial w- in bound use"
      },
      "related": [
        {
          "@id": "ehk:wesp",
          "note": "lexical bridge form",
          "relationshipType": "derived from"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "under, below, beneath (subessive suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Spatial Cases"]
        }
      ]
    },
    {
      "@id": "ehk:-eth",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-eθ",
        "writtenRep": "-eth"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *etha",
        "etymon:note": "Inherited medial indirect inanimate/default demonstrative for hidden, sensed, inferred, or expected referents.",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (medial indirect, inanimate/default; hidden, sensed, inferred, or expected)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-imris",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-im.ris",
        "writtenRep": "-imris"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "From an older bound form around Proto-Hick *ʔimer-isu or *ʔimerisu, 'breath/spirit at or outward; released breath'. Regular development gives imeris, then high-frequency bound morphology reduces imeris to imris.",
        "etymon:protoform": "Proto-Hick *ʔimerisu",
        "etymon:soundChange": "regular reduction to imeris, then bound-morphology reduction to imris"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "out of, from, outward from; source or emergence (ellative suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Spatial Cases"]
        }
      ]
    },
    {
      "@id": "ehk:-is",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-is",
        "writtenRep": "-is"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *isa",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "this (inanimate, sensed, proximal)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-itar",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-i.tar",
        "writtenRep": "-itar"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Standard/prestige superessive form from a Seneran dialect layer, probably Ranterg highland or eastern-slope speech. It replaced or displaced inherited -iter in most standard spatial use.",
        "etymon:soundChange": "dialectal raising or preservation followed by analogical spread"
      },
      "related": [
        {
          "@id": "ehk:-iter",
          "note": "older inherited inland/fossil reflex",
          "relationshipType": "contrasts with"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "on, upon, above; onto/up onto in motion contexts (superessive or surface-allative suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Spatial Cases"]
        }
      ]
    },
    {
      "@id": "ehk:-las",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-las",
        "writtenRep": "-las"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Productive Early Hick illative from a branch-specific grammaticalized allomorph, probably Proto-Maritime or Proto-Seneran *lahesu. This should be kept distinct from the fossil or borrowed Maritime *-laes/*-aes layer.",
        "etymon:protoform": "Proto-Maritime or Proto-Seneran *lahesu",
        "etymon:soundChange": "grammaticalized allomorph reduction to las"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "into, inward, into a bounded place or state; receptive/internalizing direction (illative suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Spatial Cases"]
        }
      ]
    },
    {
      "@id": "ehk:-iter",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-i.ter",
        "writtenRep": "-iter"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Regular inherited reflex of an older onset-bearing upper-surface marker, probably Proto-Hick *ʔitaru or *hitaru. Coastal/eastern standard lost it as a productive spatial suffix when -imris took over source and emergence functions, but it survives in inland, regional, and lexicalized forms.",
        "etymon:protoform": "Proto-Hick *ʔitaru or *hitaru",
        "etymon:soundChange": "regular inherited reflex with regional/fossil retention"
      },
      "related": [
        {
          "@id": "ehk:-itar",
          "note": "standard/prestige superessive counterpart",
          "relationshipType": "contrasts with"
        },
        {
          "@id": "ehk:venuiter",
          "note": "lexicalized inland/fossil use",
          "relationshipType": "preserved in"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "regional or fossil ellative-like/source-like suffix; preserved chiefly in lexicalized inland forms"
          },
          "lexinfo:semanticField": [
            "Grammatical Terms",
            "Spatial Cases",
            "Regional Forms"
          ],
          "usage": "Not the standard productive Early Hick ellative; compare -imris."
        }
      ]
    },
    {
      "@id": "ehk:-nat",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "nat",
        "writtenRep": "-nat"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:derivedFrom": "nater",
        "etymon:note": "Grammaticalized from nater 'desire, intended course', from early lexicalized Proto-Hick *nateru < *naru teru 'action-flow, course of action'.",
        "etymon:soundChange": "grammaticalization with phonological reduction"
      },
      "related": [
        {
          "@id": "ehk:nater",
          "note": "full lexical source",
          "relationshipType": "grammaticalized from"
        },
        {
          "@id": "ehk:gnater",
          "note": "related analogical desire term influenced by gnar",
          "relationshipType": "semantic domain"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "want to, desire to (desiderative suffix)"
          },
          "lexinfo:semanticField": ["Grammatical Terms", "Verbal Morphology"]
        }
      ]
    },
    {
      "@id": "ehk:-rum",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-rum",
        "writtenRep": "-rum"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *ruma",
        "etymon:note": "Inherited animate distal demonstrative. The r- may preserve an older pre-Proto-Hick animate-deictic linker, but by Proto-Hick *ruma was already distinct from inanimate/default *ʔuma.",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (animate, distant)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-tan",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-tan",
        "writtenRep": "-tan"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowedFrom": "Old Chemise tan",
        "etymon:note": "Contact-derived animate medial direct demonstrative. Old Chemise tan 'sibling, comrade' was borrowed into Princely Maritime as tan 'comrade, crewmate', then developed in Early Raibonian or Maritime Lingua Franca into a postposed medial animate demonstrative particle before Early Hick reattached it as -tan. This renewed an animate medial direct slot after the inherited animate counterpart to -en was lost or merged.",
        "etymon:protoform": "Old Chemise tan",
        "etymon:soundChange": "Old Chemise tan > Princely Maritime tan > Maritime Lingua Franca tan > Early Hick -tan"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (animate, visible, medial)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-thir",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-θir",
        "writtenRep": "-thir"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:derivedFrom": "thir",
        "etymon:note": "Native renewal of the animate medial indirect demonstrative from lexical thir 'air, wind', used for unseen natural forces and other indirectly sensed animate or agentive presences.",
        "etymon:protoform": "Early Hick thir"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (medial indirect, animate; hidden, sensed, inferred, or agentive presence)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-um",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-um",
        "writtenRep": "-um"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *ʔuma",
        "etymon:note": "Inherited inanimate/default distal demonstrative, distinct by Proto-Hick from animate *ruma.",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "that (inanimate, distant)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-ʔis",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "-ʔis",
        "writtenRep": "-ʔis"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *ʔisa",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "this (animate, sensed, proximal)"
          },
          "lexinfo:semanticField": ["Demonstratives", "Grammatical Terms"]
        }
      ]
    }
  ]
}
