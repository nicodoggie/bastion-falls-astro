            "@value": "sacred light, revelation"
          },
          "lexinfo:semanticField": [
            "Sacred Terms",
            "Light Terms",
            "Abstract Concepts"
          ],
          "usage": "Poetic and religious sense extending daylight into sacred illumination; productive in revelatory derivations."
        },
        {
