          "lexinfo:register": "lexinfo:technicalRegister",
          "lexinfo:semanticField": [
            "Construction Terms",
            "Tool Terms",
            "Borrowed Terms"
          ],
          "usage": "Borrowed technical term from Eldrim metalworking traditions"
