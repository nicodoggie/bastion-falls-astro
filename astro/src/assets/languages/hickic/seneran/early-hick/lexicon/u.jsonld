  "@id": "lexicon:EarlyHick_U",
  "@type": "lime:Lexicon",
  "dc:title": "Early Hick Lexicon - U entries",
  "dc:language": {
    "@id": "bf:hickic/seneran/early-hick",
    "skos:prefLabel": "Early Hick"
  },
  "@graph": [
    {
      "@id": "ehk:uruloke",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "u.ru.lo.ke",
        "writtenRep": "uruloke"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "urulócë",
          "etymon:sourceGloss": "red dragon; fire dragon",
          "etymon:sourceLanguage": "Quenya"
        },
        "etymon:note": "High-register borrowing for red or fire dragons.",
        "etymon:soundChange": "Quenya repair"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "red dragon; fire dragon"
          },
          "lexinfo:register": "lexinfo:formalRegister",
          "lexinfo:semanticField": [
            "Mythological Terms",
            "Borrowed Terms",
            "High Register"
          ]
        }
      ]
    },
    {
      "@id": "ehk:'u'u",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Verb"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔu.ʔu",
        "writtenRep": "'u'u"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "'u'u + -'er (verbalizer)",
          "grammaticalMeaning": "to cry, to weep",
          "phoneticRep": "ʔu.ʔu.ʔer",
          "writtenRep": "'u'u'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Onomatopoeic origin from crying/sobbing sound",
        "etymon:protoform": "Proto-Hick *'uhu-'uhu",
        "etymon:soundChange": "medial h-loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "cry, weep (in sorrow/pain)"
          },
          "lexinfo:semanticField": [
            "Sound Terms",
            "Emotion Terms",
            "Body Terms"
          ],
          "usage": "Often reduplicated for continuous crying"
        }
      ]
    },
    {
      "@id": "ehk:ul",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ul",
        "writtenRep": "ul"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "grammaticalized possessive suffix",
          "grammaticalMeaning": "possessive marker",
          "phoneticRep": "ul",
          "writtenRep": "-ul"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "ul + -'er (verbalizer)",
          "grammaticalMeaning": "to grasp",
          "phoneticRep": "ul.ʔer",
          "writtenRep": "ul'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:meaning": "grasp",
        "etymon:note": "Original root (~800 PF) had meanings 'thumb/grasp/possession'. By Late Proto-Hick (~400 PF), bare form specialized to 'thumb/possession'. Source of possessive suffix -ul through grammaticalization.",
        "etymon:protoform": "Proto-Hick *ʔulu",
        "etymon:soundChange": ["initial glottal loss", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "thumb"
          },
          "lexinfo:semanticField": ["Body Terms", "Basic Terms"]
        }
      ]
    },
    {
      "@id": "ehk:ulsar",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ul.sar",
        "writtenRep": "ulsar"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:mer"
        },
        {
          "@id": "ehk:sar"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "mer-ul-sar",
        "etymon:gloss": "bird-POSS-leaf",
        "etymon:note": "Lexicalized from 'bird's leaf'; the possessor mer became recoverable and dropped from the surface form, leaving the possessive linker attached to sar.",
        "etymon:soundChange": "compound reduction"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "feather"
          },
          "lexinfo:semanticField": [
            "Animal Terms",
            "Bird Terms",
            "Body Terms"
          ],
          "usage": "Literally 'bird's leaf'."
        }
      ]
    },
    {
      "@id": "ehk:ulsaral",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ul.sa.ral",
        "writtenRep": "ulsaral"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:ulsar"
        },
        {
          "@id": "ehk:'al"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "ulsar-'al",
        "etymon:gloss": "feather-person",
        "etymon:note": "Compound from ulsar 'feather' and 'al 'person', used for winged or birdlike peoples.",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "winged person; birdlike people"
          },
          "lexinfo:semanticField": [
            "Person Terms",
            "Animal Terms",
            "Bird Terms",
            "Mythological Terms"
          ],
          "usage": "Broad term for feathered or winged peoples, including harpies, angels, and similar beings."
        }
      ]
    },
    {
      "@id": "ehk:uran",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "u.rən",
        "writtenRep": "uran"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["*ulu (thumb)", "*haranu (length)"],
        "etymon:note": "Shows development of measurement system from body parts",
        "etymon:protoform": "Proto-Hick *ulu-haranu",
        "etymon:soundChange": ["compound fusion", "unstressed vowel reduction"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "inch (unit of length, approximately thumb-width)"
          },
          "lexinfo:semanticField": ["Measurement Terms", "Basic Terms"]
        }
      ]
    },
    {
      "@id": "ehk:us",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "us",
        "writtenRep": "us"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "us + -'er (verbalizer)",
          "grammaticalMeaning": "to possess,to own",
          "phoneticRep": "us.ʔer",
          "writtenRep": "us'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["*ʔulu (thumb/grasp)", "-isu (locative)"],
        "etymon:note": "Developed from locative form of *ʔulu (~400 PF) specializing in 'grasp' meaning",
        "etymon:protoform": "Proto-Hick *ʔulu-isu",
        "etymon:soundChange": ["vowel coalescence", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "grasp, possession"
          },
          "lexinfo:semanticField": ["Basic Terms", "Action Terms"]
        }
      ]
    }
  ]
}
