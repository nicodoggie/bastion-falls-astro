        "etymon:note": "General negation prefix grammaticalized from Proto-Hick *muru 'darkness, absence'."
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "general negation prefix: not, non-, mis-"
          },
          "examples": [
            "mo-thral 'non-sacred, profane'",
            "mo-ter 'not flowing, stagnant'",
            "mo-ward 'misdirect, lead astray'",
            "momer 'chicken' < mo-mer 'not-bird'"
          ],
          "lexinfo:semanticField": [
            "Negation",
            "Derivational Morphology",
            "Grammatical Terms"
          ],
          "usage": "Standard Early Hick negation prefix, contrasting with regional western im- as a privative prefix."
        }
      ]
    },
    {
      "@id": "ehk:mo'er",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Verb"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "mo.ʔer",
        "writtenRep": "mo'er"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:mo"
        },
        {
          "@id": "ehk:-'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "mo-'er",
        "etymon:gloss": "NEG-VERB",
        "etymon:note": "Verbalized negation used as a predicate of non-execution or prohibition in action-focused prohibitives.",
        "etymon:soundChange": "verbalizer attachment"
      },
      "related": [
        {
          "@id": "ehk:mo",
          "note": "productive negation prefix",
          "relationshipType": "derived from"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "to prohibit or negate the execution of an action; to not-do"
          },
          "examples": [
            "vinud-es mo'er! 'No building!'",
            "vinud'er-es mo'er 'al'tan-el 'You are not to build.'"
          ],
          "lexinfo:semanticField": [
            "Negation",
            "Speech Terms",
            "Action Terms",
            "Grammatical Terms"
          ],
          "usage": "Used as a prohibitive predicate with an absolutive action or verbalized action. Productive clausal negation still normally uses mo- directly on the predicate."
        }
      ]
    },
    {
      "@id": "ehk:mope",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Interjection"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "mo.pe",
        "writtenRep": "mope"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:mo"
        },
        {
          "@id": "ehk:pe"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "mo-pe",
        "etymon:gloss": "NEG-no",
        "etymon:note": "Reinforced negative answer from productive mo- plus older inherited refusal particle pe. This is negative concord, not a logical double negative.",
        "etymon:soundChange": "compound lexicalization"
      },
      "related": [
        {
          "@id": "ehk:pe",
          "note": "older childish or petulant refusal particle",
          "relationshipType": "reinforces"
        },
        {
          "@id": "ehk:mo",
          "note": "productive negation prefix",
          "relationshipType": "contains"
        },
        {
          "@id": "ehk:mo-gnar",
          "note": "transparent analytical negative answer meaning 'not correct'",
          "relationshipType": "contrasts with"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "no"
          },
          "lexinfo:semanticField": [
            "Basic Terms",
            "Speech Terms",
            "Formulaic Expressions",
            "Negation"
          ],
          "usage": "Ordinary standalone negative answer. It does not negate clauses by itself; productive clausal negation uses mo-."
        }
      ]
    },
