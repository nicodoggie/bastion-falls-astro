  "@graph": [
    {
      "@id": "ehk:ma",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Prefix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ma",
        "writtenRep": "ma-"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *ma",
        "etymon:gloss": "plural, collective",
        "etymon:note": "General plural and collective prefix. In action-event imperatives, ma- can mark collective participation and form hortatives.",
        "etymon:soundChange": "prefix grammaticalization"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "plural, collective"
          },
          "examples": [
            "ma-mater 'boats'",
            "ma-'al 'people'"
          ],
          "lexinfo:semanticField": [
            "Grammatical Terms",
            "Number Marking",
            "Derivational Morphology"
          ],
          "usage": "General plural prefix for nominal referents."
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "collective action marker in hortatives"
          },
          "examples": [
            "ma-vinud-es! 'Let's build!'",
            "ma-sinas-es! 'Let's play!'"
          ],
          "lexinfo:semanticField": [
            "Grammatical Terms",
            "Mood",
            "Speech Terms"
          ],
          "usage": "With absolutive event-call imperatives, ma- invites shared participation: ma-ACTION-es! 'let us do ACTION'."
        }
      ]
    },
