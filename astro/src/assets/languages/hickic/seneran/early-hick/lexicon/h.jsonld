    {
      "@id": "ehk:hilis",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "hi.lis",
        "writtenRep": "hilis"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "hilis + -'er (verbalizer)",
          "grammaticalMeaning": "to look (active/intentional seeing)",
          "phoneticRep": "hi.lis.ʔer",
          "writtenRep": "hilis'er"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "his (reduced form) + -'er (verbalizer)",
          "grammaticalMeaning": "to see (passive/unintentional perception)",
          "phoneticRep": "his.ʔer",
          "writtenRep": "his'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Forms two contrasting verbs: hilis'er (active looking) vs his'er (passive seeing)",
        "etymon:protoform": "Proto-Hick *hilisu",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "sight, active vision"
          },
          "lexinfo:semanticField": [
            "Perception Terms",
            "Action Terms",
            "Basic Terms"
          ]
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "sight, active vision"
          },
          "lexinfo:semanticField": ["Perception Terms", "Basic Terms"]
        }
      ]
    },
