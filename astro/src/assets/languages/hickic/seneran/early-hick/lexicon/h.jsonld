    {
      "@id": "ehk:hisimris",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Verb"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "hi.sim.ris",
        "writtenRep": "hisimris"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:his"
        },
        {
          "@id": "ehk:imris"
        }
      ],
      "derivation": {
        "@type": "ontolex:LexicalEntry",
        "canonicalForm": {
          "@type": "ontolex:Form",
          "phoneticRep": "hi.sim.ris.ʔer",
          "writtenRep": "hisimris'er"
        },
        "sense": [
          {
            "@type": "ontolex:LexicalSense",
            "definition": {
              "@language": "en",
              "@value": "to show"
            }
          }
        ]
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "his-imris",
        "etymon:gloss": "sight-ELL",
        "etymon:note": "Shows productive use of ellative case for causative meanings",
        "etymon:soundChange": "case lexicalization"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "show"
          },
          "lexinfo:semanticField": ["Perception Terms", "Action Terms"],
          "usage": "Contrasts with hilis'er 'to look'"
        }
      ]
    },
    {
      "@id": "ehk:hahu",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ha.hu",
        "writtenRep": "hahu"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "hahu + -'er (verbalizer)",
          "grammaticalMeaning": "to laugh",
          "phoneticRep": "ha.hu.ʔer",
          "writtenRep": "hahu'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:intermediateForm": "Pre-Proto-Hick *halu",
        "etymon:note": "Shows irregular sound change preserving original 'laugh' meaning while regular form *halu developed into 'good' (via hi-halu > 'il)",
        "etymon:protoform": "Proto-Hick *hahu",
        "etymon:soundChange": "irregular l → h change"
      },
      "related": [
        {
          "@id": "ehk:'il",
          "note": "from regular development of *halu",
          "relationshipType": "etymologically related to"
        },
        {
          "@id": "ehk:'ilsul",
          "note": "joy, happiness",
          "relationshipType": "semantically related to"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "laugh, laughter"
          },
          "lexinfo:semanticField": [
            "Sound Terms",
            "Emotion Terms",
            "Body Terms"
          ],
          "usage": "Preserves original meaning through irregular sound change"
        }
      ]
    }
