    {
      "@id": "ehk:nar",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Interjection"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "nar",
        "writtenRep": "nar"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "ignar",
        "etymon:gloss": "yes, correct; that is right",
        "etymon:note": "Informal reduced affirmative, associated with the naru 'action, response' element in Proto-Hick *ʔiga naru.",
        "etymon:soundChange": "formulaic clipping"
      },
      "related": [
        {
          "@id": "ehk:ignar",
          "note": "related fittingness and correctness term from the same formula",
          "relationshipType": "contrasts by register with"
        },
        {
          "@id": "ehk:gnar",
          "note": "ordinary affirmative and correctness term",
          "relationshipType": "reduced from"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "yes; yup"
          },
          "lexinfo:semanticField": [
            "Basic Terms",
            "Speech Terms",
            "Formulaic Expressions"
          ],
          "usage": "Informal affirmative response, similar to English 'yup' or 'yeah', usually in quick speech or familiar contexts."
        }
      ]
    },
    {
      "@id": "ehk:nater",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Verb"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "na.ter",
        "writtenRep": "nater"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:nar"
        },
        {
          "@id": "ehk:ter"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "Proto-Hick *nateru < *naru teru",
        "etymon:gloss": "action-flow, course of action",
        "etymon:note": "Early lexicalized stem from *naru teru 'action-flow, course of action'. Developed from 'course of action' to 'intended course' and then to desire or intention. Later reanalyzed as nat + -'er, providing the source of desiderative -nat.",
        "etymon:soundChange": ["compound fusion", "final vowel reduction"]
      },
      "related": [
        {
          "@id": "ehk:-nat",
          "note": "grammaticalized desiderative suffix",
          "relationshipType": "source of"
        },
        {
          "@id": "ehk:gnater",
          "note": "correctness-colored analogical variant associated with gnar",
          "relationshipType": "contrasts with"
        },
        {
          "@id": "ehk:nar",
          "note": "shares the naru action or response element",
          "relationshipType": "semantic domain"
        },
        {
          "@id": "ehk:naterlas",
          "note": "requestive auxiliary grammaticalized from nater + -las",
          "relationshipType": "source of"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "to desire, intend, want"
          },
          "lexinfo:semanticField": [
            "Mental Terms",
            "Emotional Terms",
            "Action Terms",
            "Basic Terms"
          ],
          "usage": "Full lexical verb beside the grammaticalized desiderative suffix -nat."
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "to be willing; to intend a course of action"
          },
          "lexinfo:semanticField": [
            "Mental Terms",
            "Action Terms",
            "Speech Terms",
            "Grammatical Terms"
          ],
          "usage": "In request constructions, nater can predicate willingness over an absolutive action: ACTION-'er-es nater AGENT-el 'is AGENT willing to do ACTION?'"
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "desire, intention; intended course"
          },
          "lexinfo:semanticField": [
            "Mental Terms",
            "Emotional Terms",
            "Action Terms"
          ],
          "usage": "Nominal or abstract use preserving the older 'course of action' sense."
        }
      ]
    },
    {
      "@id": "ehk:naterlas",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Particle"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "na.ter.las",
        "writtenRep": "naterlas"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:nater"
        },
        {
          "@id": "ehk:-las"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "nater-las",
        "etymon:gloss": "desire/willingness-ALL",
        "etymon:note": "Soft requestive auxiliary from nater 'desire, willingness, intended course' plus allative -las. Literally 'toward willingness', then grammaticalized as a polite requestive.",
        "etymon:soundChange": "case grammaticalization in request construction"
      },
      "related": [
        {
          "@id": "ehk:nater",
          "note": "lexical source meaning desire or willingness",
          "relationshipType": "grammaticalized from"
        },
        {
          "@id": "ehk:-nat",
          "note": "separate desiderative suffix from the same nater source",
          "relationshipType": "semantic domain"
        },
        {
          "@id": "ehk:-las",
          "note": "allative element supplying 'toward willingness'",
          "relationshipType": "contains"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "please; would you be willing to; requestive auxiliary"
          },
          "examples": ["vinud'er-es naterlas 'al'tan-el 'Please build.'"],
          "lexinfo:semanticField": [
            "Grammatical Terms",
            "Mood",
            "Speech Terms",
            "Formulaic Expressions"
          ],
          "usage": "Used after an absolutive verbal action and before the responsible agent in polite requests: ACTION-'er-es naterlas AGENT-el."
        }
      ]
    },
    {
      "@id": "ehk:natlas",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "nat.las",
        "writtenRep": "natlas"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "nater-las",
        "etymon:gloss": "desire-ILL",
        "etymon:note": "Shows case lexicalization. From 'one in a state of desire/affection' to 'friend'",
        "etymon:soundChange": ["compound fusion", "cluster simplification"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "friend"
          },
          "lexinfo:semanticField": ["Person Terms", "Social Terms"]
        }
      ]
    }
  ]
}
