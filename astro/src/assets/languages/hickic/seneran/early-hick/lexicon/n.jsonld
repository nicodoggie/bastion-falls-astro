        "phoneticRep": "nai",
        "writtenRep": "nai"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *nahi",
        "etymon:soundChange": "vowel coalescence"
      },
