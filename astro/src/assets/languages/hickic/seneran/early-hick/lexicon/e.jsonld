  "@graph": [
    {
      "@id": "ehk:eldalulbres",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "el.da.lul.bres",
        "writtenRep": "eldalulbres"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:eldal"
        },
        {
          "@id": "ehk:bres"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "eldal-ul-bres",
        "etymon:meaning": "elf-POSS-wind",
        "etymon:note": "Emerged after Eldrim conflicts, showing cultural trauma",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "north wind"
          },
          "lexinfo:semanticField": [
            "Weather Terms",
            "Directional Terms",
            "Cultural Terms"
          ],
          "usage": "Replaced torulbres in most dialects after Eldrim contact"
        }
      ]
    },
    {
      "@id": "ehk:eldegralen_asadimris",
      "@type": ["ontolex:LexicalEntry", "lexinfo:ProperNoun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔel.də.gra.len a.sa.dim.ris",
        "writtenRep": "'eldegralen asadimris"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "'eldegral-en asad-imris",
        "etymon:gloss": "feywild-MED.VIS.INAN bridge-ELL",
        "etymon:note": "Shows formal preservation of medial marker and ellative case"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "The Elven Bridge"
          },
          "lexinfo:semanticField": [
            "Place Names",
            "Infrastructure",
            "Sacred Terms"
          ],
          "literalMeaning": "bridge from/through the feywild",
          "usage": "Shows formal/sacred term patterns with case marking"
        }
      ]
    },
    {
      "@id": "ehk:eldul",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "el.dul",
        "writtenRep": "eldul"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "eldalulbres",
        "etymon:gloss": "elven-wind",
        "etymon:note": "Shows historical Eldrim influence on directional system",
        "etymon:soundChange": "compound reduction"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "north"
          },
          "lexinfo:semanticField": ["Directional Terms", "Wind Terms"],
          "usage": "Derived from term for north wind"
        }
      ]
    },
    {
      "@id": "ehk:eltek",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Adjective"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "el.tek",
        "writtenRep": "eltek"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["*ʔelu (INST)", "*taku (strike)"],
        "etymon:note": "From phrase 'grale ʔelu taku' (soil together hit). Shows development from physical action to resultant state",
        "etymon:protoform": "Proto-Hick *ʔelu-taku",
        "etymon:soundChange": ["compound fusion", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "compacted, condensed (especially of soil)"
          },
          "lexinfo:semanticField": ["Basic Terms", "Earth Terms"]
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "shaped from loose material"
          },
          "lexinfo:semanticField": ["Basic Terms", "Earth Terms"]
        }
      ]
    },
    {
      "@id": "ehk:-'er",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Suffix"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔer",
        "writtenRep": "'er"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:gloss": "motion",
        "etymon:protoform": "Proto-Hick *heru",
        "etymon:soundChange": ["initial h > ʔ", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "verbalizer suffix that creates verbs from nouns and property concepts"
          },
          "lexinfo:morphosyntacticProperty": "verbalizer",
          "lexinfo:partOfSpeech": "suffix",
          "usage": "Productive forms preserve -'er, while ordinary speech may collapse the glottal after sibilant-stop codas by moving the final stop into the verbalizer syllable"
        }
      ]
    },
    {
      "@id": "ehk:'eteleth",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Interrogative"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔe.te.leθ",
        "writtenRep": "'eteleth"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:gloss": "what-time-MED",
        "etymon:protoform": "Proto-Hick *haka-tel-eth"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "when (sensed time)"
          },
          "lexinfo:semanticField": ["Interrogatives", "Medial", "Temporal"]
        }
      ]
    },
    {
      "@id": "ehk:'etelum",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Interrogative"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔe.te.lum",
        "writtenRep": "'etelum"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:gloss": "what-time-DIST",
        "etymon:protoform": "Proto-Hick *haka-tel-um"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "when (unknown time)"
          },
          "lexinfo:semanticField": ["Interrogatives", "Distal", "Temporal"]
        }
      ]
    },
    {
      "@id": "ehk:etil",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "e.til",
        "writtenRep": "etil"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *etilu",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "thing"
          },
          "lexinfo:semanticField": "Basic Terms"
        }
      ]
    },
    {
      "@id": "ehk:'etil",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔe.til",
        "writtenRep": "'etil"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["hi (animacy marker)", "etilu (thing)"],
        "etymon:protoform": "Proto-Hick *hi-etilu",
        "etymon:soundChange": "animacy prefix"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "living thing"
          },
          "lexinfo:semanticField": ["Spirit Terms", "Sacred Terms"]
        }
      ]
    },
    {
      "@id": "ehk:etilsim",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Adverb"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "e.til.sim",
        "writtenRep": "etilsim"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:etil"
        },
        {
          "@id": "ehk:sim"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "etil-sim",
        "etymon:gloss": "thing-TRANS",
        "etymon:note": "Shows lexicalization of translative case into expression of both transformation and resignation",
        "etymon:soundChange": "case lexicalization"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "everything changes/transforms (with implications of resignation/indifference)"
          },
          "lexinfo:register": "philosophical-colloquial",
          "lexinfo:semanticField": ["Abstract Concepts", "Philosophical Terms"],
          "usage": "Often used as resigned response to change or loss"
        }
      ]
    },
    {
      "@id": "ehk:edel",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "e.del",
        "writtenRep": "edel"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "eðel",
          "etymon:sourceGloss": "Wood Elf",
          "etymon:sourceLanguage": "Sindarin"
        },
        "etymon:note": "Borrowed term for Wood Elves",
        "etymon:protoform": "Sindarin eðel + pre-Early Hick ʔal"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "Wood Elf"
          },
          "lexinfo:semanticField": ["Person Terms", "Borrowed Terms"],
          "usage": "Used to refer to Wood Elves, showing early contact with Elvish peoples"
        }
      ]
    },
    {
      "@id": "ehk:eter",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "e.ter",
        "writtenRep": "eter"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "etil-ter",
        "etymon:gloss": "things-flow",
        "etymon:note": "Shows metaphorical extension of flow to proper arrangement"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "flow of things; correct ordering, sorting"
          },
          "lexinfo:semanticField": ["Abstract Terms", "Motion Terms"],
          "usage": "Forms verb eter'er \"to sort, arrange\""
        }
      ]
    },
    {
      "@id": "ehk:ewes",
      "@type": [
        "ontolex:LexicalEntry",
        "lexinfo:Adposition",
        "lexinfo:Conjunction",
        "lexinfo:Particle"
      ],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "e.wes",
        "writtenRep": "ewes"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "From comitative-instrumental *ʔelu \"with, together with, by joint action\" + *lawesu \"consume, take in\", showing semantic development from \"consuming with\" to general accompaniment and joint participation.",
        "etymon:protoform": "Proto-Hick *ʔelu lawesu",
        "etymon:soundChange": "compound reduction"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "together with; together"
          },
          "lexinfo:semanticField": [
            "Basic Terms",
            "Grammatical Terms",
            "Particles",
            "Coordination"
          ],
          "usage": "Functions both as an adpositional/adverbial marker of accompaniment and as the shared-action coordinator in o...ewes constructions. When used as a set-level coordinator, it can take case or demonstrative morphology for the coordinated phrase as a whole."
        }
      ]
    },
    {
      "@id": "ehk:'eldal",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔel.dal",
        "writtenRep": "'eldal"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "elda",
          "etymon:sourceGloss": "elf",
          "etymon:sourceLanguage": "Sindarin"
        },
        "etymon:compound": "elda+'al",
        "etymon:gloss": "elf-person",
        "etymon:note": "Borrowing from Sindarin eldrim with native person marker"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "elf (individual)"
          },
          "lexinfo:semanticField": ["Person Terms", "Sacred Terms"]
        }
      ]
    },
    {
      "@id": "ehk:'eldalok",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
