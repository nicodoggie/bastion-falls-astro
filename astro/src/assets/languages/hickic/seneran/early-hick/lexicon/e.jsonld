        "@type": "ontolex:Form",
        "phoneticRep": "ʔel.da.lok",
        "writtenRep": "'eldalok"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:'eldal"
        },
        {
          "@id": "ehk:ok"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "'eldal-ok",
        "etymon:gloss": "elf-AGENT",
        "etymon:note": "Collective form using agentive suffix to mark social group"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "elven people"
          },
          "lexinfo:semanticField": ["Person Terms", "Sacred Terms"]
        }
      ]
    },
    {
      "@id": "ehk:'eldegral",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ʔel.də.gral",
        "writtenRep": "'eldegral"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:'eldal"
        },
        {
          "@id": "ehk:gral"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "'eldal-gral",
        "etymon:gloss": "elf-earth",
        "etymon:note": "Shows vowel reduction in middle syllable and sacred earth metaphor"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
