    {
      "@id": "ehk:vin",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vin",
        "writtenRep": "vin"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Maritime standard form. Inland dialects preserve venu-sedu > vinused",
        "etymon:protoform": "Proto-Hick *venu",
        "etymon:soundChange": ["vowel harmony", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "pregnancy"
          },
          "lexinfo:semanticField": ["Body Terms", "Sacred Terms"]
        }
      ]
    },
    {
      "@id": "ehk:vinlas",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vin.las",
        "writtenRep": "vinlas"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["vin (pregnancy)", "-las (illative)"],
        "etymon:compound": "vin-las",
        "etymon:gloss": "pregnancy-ILL",
        "etymon:note": "Shows lexicalization of case marking spatial relationship",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "fetus, unborn child"
          },
          "lexinfo:semanticField": ["Person Terms", "Body Terms", "Life Stages"]
        }
      ]
    },
    {
      "@id": "ehk:vinok",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vi.nok",
        "writtenRep": "vinok"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["vin (pregnancy)", "-ok (agentive)"],
        "etymon:compound": "vin-ok",
        "etymon:gloss": "pregnancy-AGENT",
        "etymon:note": "Shows semantic extension from agentive to resultative meaning",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "baby, infant"
