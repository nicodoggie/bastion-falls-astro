      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ven",
        "writtenRep": "ven"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:note": "Reintroduced from dialect after original *venu developed into vin",
