            "Person Terms",
            "Kinship Terms",
            "Life Stages"
          ]
        }
      ]
    },
    {
      "@id": "ehk:vinud",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vi.nud",
        "writtenRep": "vinud"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "vinud + -'er (verbalizer)",
          "grammaticalMeaning": "to build, to dwell",
          "phoneticRep": "vi.nu.dʔer",
          "writtenRep": "vinud'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["venu (burden)", "wudu (wood)"],
        "etymon:note": "Semantic shift from 'wood structure' to 'dwelling'",
        "etymon:protoform": "Proto-Hick *venu-wudu",
        "etymon:soundChange": ["compound fusion", "final vowel loss"]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "building, dwelling"
          },
          "lexinfo:semanticField": [
            "Structure Terms",
            "Settlement Terms",
            "Basic Terms"
          ]
        }
      ]
    },
    {
      "@id": "ehk:vinuiter",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vi.nu.i.ter",
        "writtenRep": "vinuiter"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:components": ["vinu (pregnancy)", "itar (ELL)"],
        "etymon:note": "Lexicalized from ellative case",
        "etymon:soundChange": "case lexicalization"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "to give birth"
          },
          "lexinfo:semanticField": ["Verbal Terms", "Sacred Terms"]
        }
      ]
    },
    {
      "@id": "ehk:vinusak",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "vi.nu.sak",
        "writtenRep": "vinusak"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:vinud"
        },
        {
          "@id": "ehk:sak"
        }
      ],
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "vinusak + -'er (verbalizer)",
          "grammaticalMeaning": "to hunt with dogs",
          "phoneticRep": "vi.nu.sak.ʔer",
          "writtenRep": "vinusak'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "vinud-sak",
        "etymon:gloss": "home-wolf",
        "etymon:note": "Shows recognition of dogs as domesticated wolves through compound formation",
        "etymon:soundChange": "compound fusion"
      },
      "related": [
        {
          "@id": "ehk:sak",
          "note": "wild vs. domesticated canine",
          "relationshipType": "contrasts with"
        }
      ],
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "dog"
          },
          "lexinfo:semanticField": ["Animals", "Domestic Animals"],
          "usage": "Basic term for domesticated canines"
        },
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "domesticated wolf"
          },
          "lexinfo:semanticField": ["Animals", "Domestic Animals"],
          "usage": "Technical/historical sense reflecting origin"
        }
      ]
    },
