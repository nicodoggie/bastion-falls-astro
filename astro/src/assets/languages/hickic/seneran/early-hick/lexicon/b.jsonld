    {
      "@id": "ehk:bar",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "bar",
        "writtenRep": "bar"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "bar + -las (illative)",
          "grammaticalMeaning": "personal name",
          "phoneticRep": "bar.las",
          "writtenRep": "barlas"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "bar + -imris (ellative)",
          "grammaticalMeaning": "reputation, public name",
          "phoneticRep": "ba.rim.ris",
          "writtenRep": "barimris"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "bar + -'er (verbalizer)",
          "grammaticalMeaning": "to name, to call",
          "phoneticRep": "bar.ʔer",
          "writtenRep": "bar'er"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "thral + bar",
          "grammaticalMeaning": "sacred name",
          "phoneticRep": "θral.bar",
          "writtenRep": "thralbar"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "bar + -ul (possessive)",
          "grammaticalMeaning": "name-keeper",
          "phoneticRep": "ba.rul",
          "writtenRep": "barul"
        },
        {
          "@type": "ontolex:Form",
          "decomposition": "mo- + bar (negation)",
          "grammaticalMeaning": "unnamed, nameless",
          "phoneticRep": "mo.bar",
          "writtenRep": "mobar"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *baru",
        "etymon:soundChange": "final vowel loss"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "name, mark of identity"
          },
          "lexinfo:semanticField": ["Identity Terms", "Social Terms"]
        }
      ]
    },
    {
      "@id": "ehk:barakter",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ba.rak.ter",
        "writtenRep": "barakter"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:barak"
        },
        {
          "@id": "ehk:ter"
        }
      ],
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "shortened form of barakter",
          "grammaticalMeaning": "colloquial form for league",
          "phoneticRep": "rak.ter",
          "writtenRep": "rakter"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "barak-ter",
        "etymon:gloss": "walk-time",
        "etymon:note": "Distance measure based on one hour's walking time. Shows temporal suffix used for distance measurement.",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "league (distance walkable in one hour, roughly 3-4 miles)"
          },
          "lexinfo:semanticField": [
            "Measurement Terms",
            "Distance Terms",
            "Time Terms"
          ],
          "usage": "Often shortened to rakter in colloquial speech"
        }
      ]
    },
