    {
      "@id": "ehk:branrum",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Particle"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "bran.rum",
        "writtenRep": "branrum"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "bran-rum",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "distant past, typically on the order of hundreds of years ago and older. Often used in religious or epic poetry."
          },
          "lexinfo:tense": {
            "@id": "lexinfo:past"
          },
          "lexinfo:semanticField": ["Temporal Terms", "Tense Terms"],
          "lexicog:usageExample": {
            "rdf:value": [
              {
                "@language": "ehk",
                "@value": "branrum 'ales venitar"
              },
              {
                "@language": "en",
                "@value": "The person lifted long ago"
              }
            ]
          }
        }
      ]
    },
