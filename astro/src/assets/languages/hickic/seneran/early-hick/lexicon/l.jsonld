  "@graph": [
    {
      "@id": "ehk:libres",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "li.bres",
        "writtenRep": "libres"
      },
      "decomp:subterm": [
        {
          "@id": "ehk:li"
        },
        {
          "@id": "ehk:bres"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "li-bres",
        "etymon:meaning": "DIM-wind",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "gentle wind"
          },
          "lexinfo:semanticField": ["Weather Terms", "Regional Terms"],
          "usage": "Used primarily inland for weakened western winds after mountain crossing"
        }
      ]
    },
    {
      "@id": "ehk:lik",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "lik",
        "writtenRep": "lik"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "lyg",
          "etymon:sourceGloss": "dragon, snake, drake",
          "etymon:sourceLanguage": "Sindarin"
        },
        "etymon:note": "Common lower-register borrowing for lesser dragons, drakes, and reptilian dragon-creatures; regional speech may use it where learned registers use loke.",
        "etymon:soundChange": "vowel raising, final devoicing"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "lesser dragon; drake; reptilian dragon-creature"
          },
          "lexinfo:semanticField": ["Mythological Terms", "Borrowed Terms"],
          "usage": "Common or regional draconic term, especially for lesser dragons and folk compounds; contrasts with learned loke."
        }
      ]
    },
    {
      "@id": "ehk:loke",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "lo.ke",
        "writtenRep": "loke"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "lócë",
          "etymon:sourceGloss": "dragon; serpent; lizardlike creature",
          "etymon:sourceLanguage": "Quenya"
        },
        "etymon:note": "Learned high-register draconic compound element, productive in formal dragon names and taxonomy; common or regional speech may use lik instead.",
        "etymon:soundChange": "Quenya repair"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "dragon; draconic being; draconic compound element"
          },
          "lexinfo:register": "lexinfo:formalRegister",
          "lexinfo:semanticField": [
            "Mythological Terms",
            "Borrowed Terms",
            "High Register"
          ],
          "usage": "Productive learned compound element for anything plausibly draconic."
        }
      ]
    },
    {
      "@id": "ehk:lis",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "lis",
        "writtenRep": "lis"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:morphology": {
          "prefix": "li- (DIM)",
          "root": "*su 'one'"
        },
        "etymon:note": "From diminutive prefix *li- + *su 'one', lit. 'little one'",
        "etymon:protoform": "Proto-Hick *li-su",
        "etymon:soundChange": "final vowel loss, compound fusion"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "child"
          },
          "lexinfo:semanticField": "Kinship Terms",
          "usage": "See also: Diminutive Formation, Basic Numbers"
        }
      ]
    },
    {
