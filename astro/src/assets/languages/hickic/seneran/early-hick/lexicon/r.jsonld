        "writtenRep": "ranris"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "ran-ris",
        "etymon:meaning": "stream-reed",
        "etymon:soundChange": "compound fusion"
      },
      "sense": [
