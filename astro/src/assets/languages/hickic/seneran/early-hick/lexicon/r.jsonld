    {
      "@id": "ehk:ru",
      "@type": [
        "ontolex:LexicalEntry",
        "lexinfo:Conjunction",
        "lexinfo:Particle"
      ],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ru",
        "writtenRep": "ru"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Proto-Hick *storu",
        "etymon:note": "Grammaticalized additive coordinator associated with stor 'growth, addition, increment' < Proto-Hick *storu. Since *storu regularly yields stor, ru should be treated as a clipped coordinator from the additive family rather than a direct inherited sound-change reflex.",
        "etymon:soundChange": "grammatical clipping and coordinator reduction"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "and"
          },
          "lexinfo:semanticField": ["Conjunction", "Particles", "Coordination"],
          "usage": "Set-level additive coordinator in o...ru coordination; takes case or demonstrative morphology for the coordinated phrase as a whole."
        }
      ]
    },
