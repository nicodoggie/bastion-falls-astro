  "@graph": [
    {
      "@id": "ehk:rad",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "rad",
        "writtenRep": "rad"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:borrowing": {
          "etymon:sourceForm": "raud",
          "etymon:sourceGloss": "metal",
          "etymon:sourceLanguage": "Sindarin"
        },
        "etymon:note": "Borrowed prestige-metal term used for refined foreign, elven, or magically worked metal rather than ordinary native metal.",
        "etymon:soundChange": "diphthong simplification"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "refined foreign metal; elven or magically worked metal"
          },
          "lexinfo:semanticField": [
            "Metal Terms",
            "Material Terms",
            "Borrowed Terms",
            "Magical Terms"
          ],
          "usage": "Marked borrowing used when the material is distinguished from ordinary ger 'metal'."
        }
      ]
    },
    {
      "@id": "ehk:ran",
      "@type": ["ontolex:LexicalEntry", "lexinfo:Noun"],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "ran",
        "writtenRep": "ran"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:source": "Early Hick 'iran",
        "etymon:note": "Lexical narrowing from 'iran 'bifurcation point in flowing water' to one branch of the divided flow.",
        "etymon:soundChange": "initial syllable loss after lexical narrowing"
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "stream, flowing water"
          },
          "lexinfo:semanticField": ["Natural World", "Water Features"]
        }
      ]
    },
    {
      "@id": "ehk:ranris",
