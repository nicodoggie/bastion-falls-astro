    {
      "@id": "ehk:duwes",
      "@type": [
        "ontolex:LexicalEntry",
        "lexinfo:Noun"
      ],
      "canonicalForm": {
        "@type": "ontolex:Form",
        "phoneticRep": "du.wes",
        "writtenRep": "duwes"
      },
      "derivedForms": [
        {
          "@type": "ontolex:Form",
          "decomposition": "duwes + -'er (verbalizer)",
          "grammaticalMeaning": "to eat",
          "phoneticRep": "du.wes.ʔer",
          "writtenRep": "duwes'er"
        }
      ],
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:compound": "duha-wesu",
        "etymon:gloss": "meat-cover",
        "etymon:note": "Semantic extension from 'meat-container' to general 'food'",
        "etymon:soundChange": [
          "compound fusion",
          "final vowel loss"
        ]
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "food, nourishment"
          },
          "lexinfo:semanticField": [
            "Food & Consumption Terms",
            "Basic Terms"
          ],
          "usage": "Basic term for both food and eating"
        }
      ]
    },
