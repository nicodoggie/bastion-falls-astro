        "writtenRep": "threnok"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:derivedFrom": "Early Hick thren-ok",
        "etymon:note": "Inherited -ok agentive form retained in early Middle Hick."
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "watcher, one who watches"
