      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Old Iutlandish *af",
        "etymon:note": "Borrowed possessive preposition that becomes common in speech while inherited -ul remains formal or sacred."
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "of, from"
