        "writtenRep": "arem"
      },
      "etymology": {
        "@type": "etymon:Etymology",
        "etymon:protoform": "Old Iutlandish *arm",
        "etymon:note": "Maritime borrowing with vowel repair."
      },
      "sense": [
        {
          "@type": "ontolex:LexicalSense",
          "definition": {
            "@language": "en",
            "@value": "arm, oar"
