{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@mdx-js/typescript-plugin",
      },
      {
        "name": "@astrojs/ts-plugin",
      },
    ],
    "paths": {
      "@/*": ["./src/*"],
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
  },
  "mdx": {
    "plugins": [["remark-frontmatter", ["toml", "yaml"]]],
    "checkMdx": true,
    "frontmatter": {
      "schemas": [
        {
          "fileMatch": ["src/content/**/*.mdx"],
          "url": ".astro/collections/collections.json",
        },
      ],
    },
    "paths": {
      "@/*": ["./src/*"],
    },
  },
}
