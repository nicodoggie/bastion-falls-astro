{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@mdx-js/typescript-plugin",
      },
      {
        "name": "@astrojs/ts-plugin",
      },
    ],
    "paths": {
      "@/*": ["./src/*"],
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
  },
  "mdx": {
    "checkMdx": true,
    "paths": {
      "@/*": ["./src/*"],
    },
  },
}
