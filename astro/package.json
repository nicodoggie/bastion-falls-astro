    "@bastion-falls/types": "workspace:^",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify-json/solar": "^1.2.5",
    "@panzoom/panzoom": "^4.6.2",
    "@sasza/react-panzoom": "^1.19.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.3",
    "astro-expressive-code": "^0.43.1",
    "astro-mermaid": "^2.1.0",
    "bluebird": "^3.7.2",
    "flowbite": "^4.0.2",
    "flowbite-react": "^0.12.17",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "json2toml": "^7.0.0",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-render": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.35.2",
    "smol-toml": "^1.7.0",
    "starlight-auto-sidebar": "^0.4.0",
