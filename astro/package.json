{
  "name": "@bastion-falls/astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && astro build",
    "calendar:resolve": "_REAL_CWD=$INIT_CWD pnpm -F @bastion-falls/cli run exec calendar resolve",
    "calendar:prepare": "if [ -n \"$TURBO_HASH\" ]; then pnpm run calendar:resolve; else pnpm -F @bastion-falls/calendar build && pnpm -F @bastion-falls/fantasy-calendar build && pnpm run calendar:resolve; fi",
    "predev": "pnpm run calendar:prepare",
    "prestart": "pnpm run calendar:prepare",
    "prebuild": "pnpm run calendar:prepare",
    "preview": "astro preview",
    "astro": "astro",
    "fmt:biome": "biome check --write .",
    "fmt:mdx": "rumdl fmt src -c ../.rumdl.toml",
    "fmt:mdsf": "mdsf format src",
    "fmt:yaml": "eslint --config eslint.yaml.config.mjs --fix \"src/content/docs/world/**/*.{yaml,yml}\"",
    "lint:astro": "astro check",
    "lint:biome": "biome check .",
    "lint:mdx": "rumdl check src -c ../.rumdl.toml",
    "lint:mdsf": "mdsf verify src",
    "lint:yaml": "eslint --config eslint.yaml.config.mjs \"src/content/docs/world/**/*.{yaml,yml}\"",
    "fmt": "turbo run fmt:all",
    "lint": "turbo run lint:all",
    "postinstall": "flowbite-react install",
    "bfcli": "_REAL_CWD=$INIT_CWD pnpm -F @bastion-falls/cli run exec"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.3.2",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/node": "^11.1.8",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@bastion-falls/5e-schema-zod": "workspace:^",
    "@bastion-falls/astro-lexicon-integration": "workspace:^",
    "@bastion-falls/calendar": "workspace:^",
    "@bastion-falls/lexicon-components": "workspace:^",
    "@bastion-falls/satteri-auto-import": "workspace:^",
    "@bastion-falls/satteri-markmap": "workspace:^",
    "@bastion-falls/types": "workspace:^",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/solar": "^1.2.13",
    "@panzoom/panzoom": "^4.6.2",
    "@sasza/react-panzoom": "^1.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "astro-expressive-code": "^0.44.3",
    "astro-mermaid": "^2.1.0",
    "bluebird": "^3.7.2",
    "flowbite": "^4.0.2",
    "flowbite-react": "^0.12.17",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "json2toml": "^7.0.1",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-render": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-links-validator": "^0.24.1",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "^2.5.15",
    "@mdx-js/language-server": "^0.6.4",
    "@mdx-js/typescript-plugin": "^0.1.4",
    "@nicodoggie/kingraph": "^0.5.0",
    "@types/bluebird": "^3.5.42",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-yml": "^3.9.0",
    "mdxlint": "^1.0.0",
    "remark-frontmatter": "^5.0.0",
    "rumdl": "^0.2.79",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "unified": "^11.0.5"
  },
  "volta": {
    "extends": "../package.json"
  }
}
