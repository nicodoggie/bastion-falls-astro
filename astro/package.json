    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-yml": "^3.5.0",
    "kingraph": "^0.3.2",
    "mdxlint": "^1.0.0",
    "rumdl": "^0.2.22",
    "tsx": "^4.22.4",
    "unified": "^11.0.5"
  },
  "volta": {
    "extends": "../package.json"
  }
