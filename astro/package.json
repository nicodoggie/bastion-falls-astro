{
  "name": "@bastion-falls/astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format:biome": "biome check --write .",
    "format:mdx": "rumdl fmt src",
    "format:yaml": "eslint --config eslint.yaml.config.mjs --fix \"src/content/docs/world/**/*.{yaml,yml}\"",
    "lint:astro": "astro check",
    "lint:biome": "biome check .",
    "lint:mdx": "rumdl check src",
    "lint:yaml": "eslint --config eslint.yaml.config.mjs \"src/content/docs/world/**/*.{yaml,yml}\"",
    "fmt": "pnpm format:biome && pnpm format:mdx && pnpm format:yaml",
    "lint": "pnpm lint:astro && pnpm lint:biome && pnpm lint:mdx && pnpm lint:yaml",
    "postinstall": "flowbite-react install",
    "bfcli": "_REAL_CWD=$INIT_CWD pnpm -F @bastion-falls/cli run exec"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "^0.2.3",
    "@astrojs/markdown-satteri": "^0.3.2",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.1",
    "@bastion-falls/5e-schema-zod": "workspace:^",
    "@bastion-falls/astro-lexicon-integration": "workspace:^",
    "@bastion-falls/lexicon-components": "workspace:^",
