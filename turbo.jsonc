{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "@bastion-falls/5e-schema-zod#build": {
      "outputs": [
        "dist/index.js",
        "dist/index.d.ts"
      ]
    },
    "@bastion-falls/cli#build": {
      "outputs": [
        "dist/bash-complete.js",
        "dist/cli.js",
        "dist/chunks/*.js",
        "dist/templates/*.ejs"
      ]
    },
    "@bastion-falls/astro-lexicon-integration#build": {
      "outputs": [
        "dist/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".astro/**", "astro/dist/**"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
    },
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false,
    },
    "lint": {
      "dependsOn": ["^lint"],
    },
    "fmt": {
      "dependsOn": ["^fmt"],
    },
  },
}
