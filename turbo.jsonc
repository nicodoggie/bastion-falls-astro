{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".astro/**", "astro/dist/**"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
    },
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false,
    },
    "lint": {
      "dependsOn": ["^lint"],
    },
    "fmt": {
      "dependsOn": ["^fmt"],
    },
  },
}
