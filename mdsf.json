{
  "$schema": "https://raw.githubusercontent.com/hougesen/mdsf/main/schemas/v0.12.1/mdsf.schema.json",
  "files": {
    "extensions": ["md", "mdx"]
  },
  "languages": {
    "c": "clang-format",
    "cpp": "clang-format",
    "csharp": "csharpier",
    "go": [
      ["gci", "goimports-reviser", "goimports"],
      ["gofumpt", "gofmt"]
    ],
    "java": "google-java-format",
    "javascript": "prettier",
    "json": "prettier",
    "python": [
      ["usort", "isort"],
      ["ruff:format", "blue", "black", "yapf", "autopep8", "pyink"]
    ],
    "ruby": [["rubocop", "rufo", "rubyfmt", "standardrb"]],
    "rust": "rustfmt",
    "shell": [["shfmt", "beautysh"]],
    "sql": [["sql-formatter", "sqlfluff:format", "sqlfmt"]],
    "toml": "taplo",
    "typescript": "prettier",
    "text": [],
    "yaml": "prettier",
    "markdown": [["rumdl:check:fix"]],
    "markmap": [["rumdl:check:fix"]],
    "mdx": [["rumdl:check:fix"]],
    "astro": []
  }
}
