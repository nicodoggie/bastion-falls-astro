{
  "name": "@bastion-falls/5e-schema-zod",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm run generate && tsc -p tsconfig.build.json",
    "dev": "pnpm run generate && tsc -p tsconfig.build.json --watch",
    "generate": "tsx scripts/generate.ts"
  },
  "dependencies": {
    "5etools-utils": "latest",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/node": "~24.7.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
