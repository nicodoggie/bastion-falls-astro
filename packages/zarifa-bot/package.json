{
  "name": "@bastion-falls/zarifa-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Discord slash-command bot running on Cloudflare Workers, using Cloudflare AI Search",
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "register": "node ./scripts/register.mjs"
  },
  "devDependencies": {
    "@types/node": "~24.7.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.104.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "dotenv": "^17.4.2"
  }
}
