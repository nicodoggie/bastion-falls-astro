---
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import type { LexItem } from "@bastion-falls/types";
import LexiconEntryBlock from "./LexiconEntryBlock.astro";
import LexPagination from "./LexPagination.astro";

export interface ByFieldRow {
  fieldLabel: string;
  fieldUri: string;
  item: LexItem;
  /** When false, omit section heading (continuation from previous page). */
  showFieldHeading: boolean;
}

interface Props {
  rows: ByFieldRow[];
  basePath: string;
  lexiconBasePath?: string;
  fieldRoutes?: unknown[];
  page: number;
  pageCount: number;
  showFieldIndex?: boolean;
  indexFieldUris?: string[];
  indexFieldLabels?: string[];
}

const {
  rows,
  basePath,
  page,
  pageCount,
  showFieldIndex = false,
  indexFieldUris = [],
  indexFieldLabels = [],
} = Astro.props;
---

<div id="lex-page-top" aria-hidden="true" class="lex-page-top-anchor"></div>
<div class="lex-by-field-page">
  {
    showFieldIndex && indexFieldUris.length ? (
      <>
        <h2 id="semantic-fields-ref">Semantic fields reference</h2>
        <ul>
          {indexFieldUris.map((uri, i) => (
            <li>
              <a href={`#${uri}`}>{indexFieldLabels[i] ?? uri}</a>
            </li>
          ))}
        </ul>
      </>
    ) : null
  }

  <LexPagination basePath={basePath} page={page} pageCount={pageCount} />

  <div class="lex-items">
    {
      rows.map((row) => (
        <>
          {row.showFieldHeading ? (
            <AnchorHeading level={2} id={row.fieldUri}>
              {row.fieldLabel}
            </AnchorHeading>
          ) : null}
          <LexiconEntryBlock item={row.item} />
        </>
      ))
    }
  </div>

  <LexPagination basePath={basePath} page={page} pageCount={pageCount} />
</div>
