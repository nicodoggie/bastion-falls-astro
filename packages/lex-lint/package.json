{
  "name": "lex-lint",
  "version": "0.1.0",
  "description": "OntoLex-oriented JSON-LD linter for lexicon JSON with embedded graphEntry fragments.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "shapes",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "cli": "node ./dist/cli.js",
    "lint": "node ./dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/dataset": "^2.0.2",
    "@rdfjs/environment": "^1.0.0",
    "@rdfjs/namespace": "^2.0.1",
    "@rdfjs/term-map": "^2.0.2",
    "clownface": "^2.0.3",
    "glob": "^11.0.3",
    "jsonc-parser": "^3.3.1",
    "jsonld": "^9.0.0",
    "n3": "^2.0.3",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/node": "~24.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
