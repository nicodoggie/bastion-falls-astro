{
  // Folder-specific settings
  //
  // For a full list of overridable settings, and general information on folder-specific settings,//zed.dev/docs/configuring-zed#settings-files
  "semantic_tokens": "combined",
  "document_symbols": "on",
  "tab_size": 2,
  "formatter": "auto",
  "languages": {
    "Astro": {
      "language_servers": ["astro-language-server", "..."],
    },
    "Markdown": {
      "language_servers": ["rumdl"],
      "format_on_save": "on",
    },
    "MDX": {
      // mdx-analyzer currently crashes in Zed's extension cache because
      // vscode-markdown-languageservice imports a default export from
      // vscode-uri@3, which only exposes named ESM exports.
      "language_servers": ["rumdl"],
      "format_on_save": "on",
    },
  },
  "lsp": {
    "astro-language-server": {
      "initialization_options": {
        "contentIntellisense": true,
        "provideFormatter": true,
        "typescript": {
          "tsdk": "node_modules/typescript/lib",
        },
      },
    },
    "rumdl": {
      "binary": {
        "path": "/usr/bin/rumdl",
        "arguments": ["server"],
      },
    },
  },
}
