{
  // Folder-specific settings
  //
  // For a full list of overridable settings, and general information on folder-specific settings,//zed.dev/docs/configuring-zed#settings-files
  "semantic_tokens": "combined",
  "document_symbols": "on",
  "tab_size": 2,
  "formatter": "auto",
  "languages": {
    "Astro": {
      "language_servers": ["astro-language-server", "..."],
    },
    "Markdown": {
      "language_servers": ["rumdl"],
      "format_on_save": "on",
    },
    "MDX": {
      "language_servers": [
        "rumdl",
        "mdx-analyzer",
        "path-server-lsp",
        "astro-language-server",
      ],
      "formatter": {
        "external": {
          "command": "rumdl",
          "arguments": [
            "fmt",
            "--config",
            ".rumdl.toml",
            "-s",
            "--stdin",
            "--stdin-filename",
            "{buffer_path}",
          ],
        },
      },
      "code_actions_on_format": {},
    },
  },
  "lsp": {
    "astro-language-server": {
      "initialization_options": {
        "contentIntellisense": true,
        "provideFormatter": true,
        "typescript": {
          "tsdk": "node_modules/typescript/lib",
        },
      },
    },
    "mdx-analyzer": {
      "initialization_options": {
        "typescript": {
          "enabled": true,
          "tsdk": "../bastion-falls-astro/astro/node_modules/typescript/lib",
        },
        "mdx": {
          "frontmatter": {
            "schemas": [
              {
                "fileMatch": ["astro/src/content/**/*.mdx"],
                "url": "./astro/.astro/collections/docs.schema.json",
              },
            ],
          },
        },
      },
      "settings": {
        "mdx": {
          "frontmatter": {
            "schemas": [
              {
                "fileMatch": ["astro/src/content/**/*.mdx"],
                "url": "./astro/.astro/collections/docs.schema.json",
              },
            ],
          },
        },
      },
    },
    "rumdl": {
      "binary": {
        "path": "/usr/bin/rumdl",
        "arguments": [
          "server",
          "--config",
          "${ZED_WORKSPACE_ROOT}/.rumdl.toml",
        ],
      },
    },
  },
}
